# Optional AWS credentials for Bedrock-generated customer insights.
# Omit these when running on a role/instance profile with Bedrock access.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Bedrock model and region for Customer 360 AI insights (default LLM provider).
# Override region/model in Data & Admin → Configuration → LLM provider.
# Use a real AWS region (e.g. us-east-1). Avoid "global" unless you use inference profiles.
CUSTOMER360_BEDROCK_REGION=us-east-1
CUSTOMER360_BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
CUSTOMER360_BEDROCK_MAX_TOKENS=900
CUSTOMER360_BEDROCK_TEMPERATURE=0.35

# PrivateAI endpoints (OpenAI-style HTTP APIs) are configured in the admin UI;
# the API token is stored in the local admin database and is never returned by the API.
