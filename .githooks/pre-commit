#!/bin/sh
# Reject Banking Control file changes when not on the feature branch.
TARGET_BRANCH="cursor/banking-control-solution-8b7c"
BRANCH=$(git branch --show-current)

if [ "$BRANCH" = "$TARGET_BRANCH" ]; then
  exit 0
fi

STAGED=$(git diff --cached --name-only)
if [ -z "$STAGED" ]; then
  exit 0
fi

echo "$STAGED" | grep -qE '^(banking_control/|4_application/|1_session-install-dependencies/|2_job-init-database/|frontend/dist/|data/schema\.sql|scripts/init_db\.py|\.project-metadata\.yaml|amp-catalog\.yaml|docs/CAI_APPLICATION\.md|AGENTS\.md|\.githooks/)' || exit 0

echo "pre-commit: Banking Control changes must be committed on branch '$TARGET_BRANCH' (current: '$BRANCH')."
echo "Run: git checkout $TARGET_BRANCH"
exit 1
